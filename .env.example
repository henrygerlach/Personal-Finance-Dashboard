# Copy to .env and fill in. .env is gitignored; this file is not, so nothing
# here may ever hold a real value.
#
# Only the first line is needed to run the app. Everything below it has a
# working default in app/config.py and is listed so the knobs are findable.

ANTHROPIC_API_KEY=sk-ant-...

# --- Sessions ----------------------------------------------------------------
# Signs the login cookie. Left unset, a new key is generated every restart,
# which just signs everyone out rather than doing anything insecure — set this
# to keep people signed in across deploys.
# SESSION_SECRET_KEY=

# --- Database ---------------------------------------------------------------
# Both are set by .mise.toml, which is why they are commented out here. Setting
# them in .env as well only invites the two files to disagree.
#
# MONGODB_URL=mongodb://localhost:27018
# DATABASE_NAME=bank_analyzer_dev

# --- Classification ---------------------------------------------------------
# CLASSIFICATION_MODEL=claude-haiku-4-5
# CLASSIFICATION_ESCALATION_MODEL=claude-sonnet-5   # empty string switches escalation off
# CLASSIFICATION_CONFIDENCE_THRESHOLD=0.7           # below this a result goes to review
# CLASSIFICATION_BATCH_SIZE=25
# CLASSIFICATION_MAX_ATTEMPTS=3
# CLASSIFICATION_CONCURRENCY=4
# CLASSIFICATION_ENABLED=true

# --- The switched-off rule engine -------------------------------------------
# RULES_ENABLED=false
# COMPARISON_MODE_ENABLED=true
# COMPARISON_LOG_PATH=logs/classification-comparison.log

# --- Comdirect API (optional) -----------------------------------------------
# Live account balances only. Needs the optional comdirect extra, which is
# installed by `mise run install` and skipped by a plain `poetry install`.
# Credentials themselves are entered per user through the dashboard and
# stored Fernet-encrypted; only the key that encrypts them goes here. Saving
# credentials is refused while this is unset. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# COMDIRECT_CREDENTIALS_KEY=

# LOG_LEVEL=INFO
